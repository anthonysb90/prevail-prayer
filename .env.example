# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# RevenueCat (get from app.revenuecat.com after creating your project)
EXPO_PUBLIC_RC_IOS_KEY=your_revenuecat_ios_api_key
EXPO_PUBLIC_RC_ANDROID_KEY=your_revenuecat_android_api_key

# PostHog analytics (get the project API key from app.posthog.com → Settings)
EXPO_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
